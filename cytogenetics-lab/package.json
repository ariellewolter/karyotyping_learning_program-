{
  "name": "cytogenetics-lab-instruction",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "Educational karyotyping and ISCN laboratory platform. Not for clinical diagnosis.",
  "scripts": {
    "start": "python3 serve.py",
    "desktop": "electron .",
    "package": "electron-builder --mac --win",
    "package:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "package:mac:signed": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "postinstall": "node electron/ensure-binary.js && electron-builder install-app-deps",
    "templates": "python3 scripts/generate_templates.py",
    "check:bands": "node scripts/check-band-span.mjs",
    "check:lookup": "node scripts/check-lookup-engine.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:fish": "node scripts/check-fish-cases.mjs",
    "check:drawing": "node scripts/check-drawing.mjs",
    "check:derivatives": "node scripts/check-derivatives.mjs",
    "check:analysis": "node scripts/check-analysis.mjs",
    "check:cohort": "node scripts/check-cohort.mjs",
    "check:polish": "node scripts/check-polish.mjs",
    "check:interpretation": "python3 -m unittest discover -s reference-database/tests -v"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "edu.odu.cytogenetics.lab",
    "productName": "Cytogenetics Laboratory",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "data/**/*",
      "assets/**/*",
      "electron/**/*",
      "reference-database/data/cytogenetics.sqlite",
      "reference-database/data/normalized/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "reference-database/**/*",
      "data/diseases.json",
      "data/disease-activities.json",
      "**/node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
